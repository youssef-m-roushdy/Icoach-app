# ============================================================================
# API Configuration - NOW USING API GATEWAY
# ============================================================================

# For Android Emulator: use 10.0.2.2 (special alias for host machine)
# For iOS Simulator: use localhost
# For Physical Device: use your computer's local IP (e.g., 192.168.1.6)

# Gateway URL (Single entry point for all services)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
# OR for Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
# OR for Physical Device:
# EXPO_PUBLIC_API_URL=http://192.168.1.6:8080/api

# AI endpoints are now under the same gateway
# Gateway routes: /api/v1/ai/* → FastAPI
EXPO_PUBLIC_AI_API_URL=http://10.0.2.2:8080/api
# OR for Android Emulator:
# EXPO_PUBLIC_AI_API_URL=http://10.0.2.2:8080/api

# ============================================================================
# WebSocket Configuration (through Gateway)
# ============================================================================
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080
# OR for Android Emulator:
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8080
# OR for Physical Device:
# EXPO_PUBLIC_WS_URL=ws://192.168.1.6:8080

# Environment
EXPO_PUBLIC_ENV=development

# ngrok env:
