{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8001" },
      "gRPC": { "Url": "http://+:5001", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=payments_db;Username=postgres;Password=123"
  },
  "Jwt": {
    "Issuer": "your-nodejs-server",
    "Audience": "your-app",
    "PublicKeyPath": "keys/public.pem"
  },
  "Stripe": {
    "SecretKey": "sk_test_your_stripe_secret",
    "WebhookSecret": "whsec_your_webhook_secret",
    "SuccessUrl": "https://app.com/success?paymentId={PAYMENT_ID}",
    "CancelUrl": "https://app.com/cancel",
    "SubscriptionSuccessUrl": "https://app.com/sub-success?userId={USER_ID}",
    "SubscriptionCancelUrl": "https://app.com/sub-cancel",
    "WebhookToleranceSeconds": 300,
    "Prices": {
      "AppMonthly": "price_1xxx",
      "AppYearly": "price_2xxx",
      "CoachMonthly": "price_3xxx",
      "CoachYearly": "price_4xxx"
    }
  },
  "Paymob": {
    "ApiKey": "",
    "SecretKey": "",
    "PublicKey": "",
    "WebhookHmacSecret": "",
    "IntegrationId": 0,
    "BaseUrl": "https://accept.paymob.com/api"
  },
  "PayPal": {
    "ClientId": "",
    "ClientSecret": "",
    "WebhookId": "",
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "UseSandbox": true
  },
  "MainServer": {
    "WebhookBaseUrl": "http://localhost:5000",
    "WebhookSecret": "your-shared-hmac-secret-with-nodejs-server",
    "TimeoutSeconds": 10
  },
  "Outbox": {
    "MaxRetries": 5,
    "BatchSize": 20,
    "PollIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
